  "cards": [
    {
      "dot": "cyan",
      "title": "双入口，同一领域",
      "items": [
        "Studio 通过 Runtime Adapter 调用 ECC；ECC CLI 直接调用同一套 headless APIs",
        "CLI 不启动 Runtime Adapter，Renderer 也不直接访问 ECC 或 JSON-RPC"
      ]
    },
    {
      "dot": "emerald",
      "title": "事实与写入所有权",
      "items": [
        "ECC 独占 Project Manifest、Workspace Descriptor、Revision、失效与 Snapshot 语义",
        "Electron 只负责授权、生命周期、命令编排和 Renderer-facing Read Model"
      ]
    },
    {
      "dot": "amber",
      "title": "一次运行的闭环",
      "items": [
        "命令携带 Workspace Handle、commandId / idempotencyKey 与 expectedWorkspaceRevision",
        "ECC commit → runtime.event → Electron invalidate → Renderer refresh"
      ]
    }
  ]
